# Copy this file to .env and fill in the key(s) you use. prompteval reads
# .env and evals/.env automatically; a variable already set in your shell or
# CI wins. Keys are sent only to the provider you call, never anywhere else.
#
# OpenAI (default provider, and the default llm_judge model):
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
#
# Other OpenAI-compatible providers: name the variable with --api-key-env,
# or api_key_env in prices.yaml. For example:
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# A local Ollama server needs no key.
